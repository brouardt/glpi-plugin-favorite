msgid "Favorites Plugin"
msgstr "កម្មវិធីជំនួយសំណព្វ"

msgid "Favorite"
msgstr "សំណព្វចិត្ត"

msgid "Favorites"
msgstr "ចំណូលចិត្ត"

msgid "Installed / not configured"
msgstr "បានដំឡើង / មិនបានកំណត់រចនាសម្ព័ន្ធ"

msgid "List"
msgstr "បញ្ជី"

msgid "No results found"
msgstr "រកមិនឃើញលទ្ធផលទេ"

msgid "Default"
msgstr "លំនាំដើម"

msgid "Displayed menus"
msgstr "ម៉ឺនុយដែលបានបង្ហាញ"

msgid "You do not have permission to modify this item"
msgstr "អ្នកមិនមានសិទ្ធិកែប្រែធាតុនេះទេ"

msgid "Disable additive ticket menu"
msgstr "បិទម៉ឺនុយសំបុត្របន្ថែម"

msgid "Menu always in first"
msgstr "ម៉ឺនុយតែងតែមុនគេ"

msgid "No blocking configuration checks"
msgstr "គ្មានការត្រួតពិនិត្យការកំណត់រចនាសម្ព័ន្ធដែលរារាំងទេ"

msgid "This plugin requires PHP %s or higher"
msgstr "កម្មវិធីជំនួយនេះតម្រូវឱ្យមាន PHP %s ឬខ្ពស់ជាងនេះ"
