msgid "Favorites Plugin"
msgstr "ফেভারিটস প্লাগিন"

msgid "Favorite"
msgstr "প্রিয়"

msgid "Favorites"
msgstr "পছন্দসমূহ"

msgid "Installed / not configured"
msgstr "ইনস্টল করা হয়েছে / কনফিগার করা হয়নি"

msgid "List"
msgstr "তালিকা"

msgid "No results found"
msgstr "কোনো ফলাফল পাওয়া যায়নি"

msgid "Default"
msgstr "ডিফল্ট"

msgid "Displayed menus"
msgstr "প্রদর্শিত মেনুসমূহ"

msgid "You do not have permission to modify this item"
msgstr "এই আইটেমটি পরিবর্তন করার অনুমতি আপনার নেই"

msgid "Disable additive ticket menu"
msgstr "অ্যাডিটিভ টিকিট মেনু নিষ্ক্রিয় করুন"

msgid "Menu always in first"
msgstr "মেনু সর্বদা প্রথমে"

msgid "No blocking configuration checks"
msgstr "কোনো ব্লকিং কনফিগারেশন পরীক্ষা নেই"

msgid "This plugin requires PHP %s or higher"
msgstr "এই প্লাগিনটির জন্য PHP %s বা তার পরবর্তী সংস্করণ প্রয়োজন।"
